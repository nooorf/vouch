# ---- PayPal sandbox ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Sandbox Business account that plays the freelancer (receives captures)
PAYPAL_FREELANCER_EMAIL=
# Sandbox Personal account judges use to pay on demo jobs (shown on the demo client page)
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
# After deploying: PayPal developer dashboard > your app > Add Webhook > https://<app>/api/paypal/webhook
# with the 6 events in src/lib/paypal/webhook-event.ts; paste the Webhook ID here
PAYPAL_WEBHOOK_ID=

# ---- AI provider (gemini or groq first; the other is the fallback) ----
LLM_PROVIDER=gemini

# ---- Google Gemini (aistudio.google.com > Get API key; free, no card) ----
GEMINI_API_KEY=
# Pinned so behaviour can't shift mid-judging; fallback is used on 429/503
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Groq (free tier, https://console.groq.com/keys): fallback when Gemini is out of quota or busy.
# LLM_PROVIDER picks which is tried first.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ---- Neon Postgres ----
# Direct (non-pooled) string: used by migrations (drizzle-kit)
DATABASE_URL=
# Pooled string (host contains -pooler): used by the app at runtime
DATABASE_URL_POOLED=

# ---- Auth.js + GitHub OAuth app (freelancer login) ----
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---- GitHub fine-grained token, public repos read-only (repo checks) ----
GITHUB_TOKEN=

# ---- Google PageSpeed Insights API key (Lighthouse scores + screenshots; needed in practice:
# the keyless quota is shared worldwide and is often exhausted) ----
PAGESPEED_API_KEY=

# ---- Rendering web apps in a real browser ----
# auto: Kernel if KERNEL_API_KEY is set, otherwise local Chrome in development
RENDERER=auto
# Kernel cloud browsers (kernel.sh), used by the deployed app
KERNEL_API_KEY=
# Local Chrome (auto-detected on macOS)
CHROME_PATH=

# ---- Resend (emails) ----
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ---- App ----
# Protects /api/cron/tick (min 16 chars, e.g. openssl rand -hex 24). Also a GitHub repo secret, with APP_URL,
# for the scheduled Tick workflow (.github/workflows/tick.yml)
CRON_SECRET=
# Local development only: let the referee check http://localhost (e.g. the demo sites)
REFEREE_ALLOW_LOCALHOST=false
# Public GitHub repo the one-click demo deliveries attach when a brief checks the code (default: this repo)
DEMO_REPO_URL=
APP_URL=http://localhost:3000
DEMO_MODE=false
