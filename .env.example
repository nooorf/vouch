# ---- PayPal sandbox ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Sandbox Business account that plays the freelancer (receives captures)
PAYPAL_FREELANCER_EMAIL=
# Sandbox Personal account judges use to pay on demo jobs (shown on the demo client page)
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
# Filled in on Day 2, after the webhook is registered against the Render URL
PAYPAL_WEBHOOK_ID=

# ---- AI provider (gemini today; groq planned as a fallback) ----
LLM_PROVIDER=gemini

# ---- Google Gemini (aistudio.google.com > Get API key; free, no card) ----
GEMINI_API_KEY=
# Pinned so behaviour can't shift mid-judging; fallback is used on 429/503
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# ---- Neon Postgres ----
# Direct (non-pooled) string: used by migrations (drizzle-kit)
DATABASE_URL=
# Pooled string (host contains -pooler): used by the app at runtime
DATABASE_URL_POOLED=

# ---- Auth.js + GitHub OAuth app (freelancer login) ----
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---- GitHub fine-grained token, public repos read-only (repo checks) ----
GITHUB_TOKEN=

# ---- Google PageSpeed Insights API key (Lighthouse scores + screenshots) ----
PAGESPEED_API_KEY=

# ---- Resend (emails) ----
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ---- App ----
CRON_SECRET=
APP_URL=http://localhost:3000
DEMO_MODE=false
