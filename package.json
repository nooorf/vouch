{
  "name": "vouch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "smoke": "node --env-file-if-exists=.env.local --import tsx scripts/smoke.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "node --env-file-if-exists=.env.local --import tsx scripts/db-check.ts",
    "brief:try": "node --env-file-if-exists=.env.local --import tsx scripts/draft-brief.ts",
    "demo:warm": "node --env-file-if-exists=.env.local --import tsx scripts/warm-ai-cache.ts",
    "e2e": "node --env-file-if-exists=.env.local --import tsx scripts/e2e.ts",
    "env:check": "node --env-file-if-exists=.env.local --import tsx scripts/env-check.ts",
    "eval": "node --env-file-if-exists=.env.local --import tsx evals/run.ts",
    "demo:cleanup": "node --env-file-if-exists=.env.local --import tsx scripts/cleanup-demo.ts",
    "referee": "node --env-file-if-exists=.env.local --import tsx scripts/referee.ts"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@paypal/paypal-server-sdk": "2.5.0",
    "@paypal/react-paypal-js": "10.6.1",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.4",
    "geist": "1.8.2",
    "next": "16.4.3",
    "postgres": "4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "puppeteer-core": "25.16.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
